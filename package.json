{
  "name": "driverops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:finance": "tsx --test src/lib/scoring/scoreShift.test.ts",
    "test": "npm run test:finance && npm run test:events && npm run test:validation && npm run test:rules && npm run test:rules-storage && npm run test:recommendation-inputs && npm run test:recommendation-source && npm run test:recommendation-history && npm run test:dev-seeds && npm run test:decision-snapshot && npm run test:action-options && npm run test:forecasts && npm run test:calibration && npm run test:learning && npm run test:evidence && npm run test:policy && npm run test:experiments && npm run test:simulation && npm run test:execution && npm run test:timeline && npm run test:hardening && npm run test:reviews && npm run test:knowledge && npm run test:real-data",
    "check": "npm run lint && npm test",
    "test:events": "tsx --test src/lib/storage/events.test.ts",
    "test:validation": "tsx --test src/lib/validation/shiftCloseout.test.ts",
    "test:rules": "tsx --test src/lib/rules/evaluateDriveRules.test.ts",
    "test:rules-storage": "tsx --test src/lib/storage/rules.test.ts",
    "test:recommendation-inputs": "tsx --test src/lib/storage/recommendationInputs.test.ts",
    "test:recommendation-source": "tsx --test src/lib/recommendations/source.test.ts",
    "test:recommendation-history": "tsx --test src/lib/recommendations/historyAverages.test.ts",
    "dev:seed-sample-shifts": "node scripts/seed-sample-shifts.mjs",
    "test:dev-seeds": "tsx --test src/lib/dev/sampleShifts.test.ts",
    "test:decision-snapshot": "tsx --test src/lib/recommendations/getDecisionSnapshot.test.ts",
    "test:action-options": "tsx --test src/lib/recommendations/actionOptions.test.ts",
    "test:forecasts": "tsx --test src/lib/recommendations/forecasts.test.ts",
    "test:calibration": "tsx --test src/lib/calibration/forecastCalibration.test.ts",
    "test:learning": "tsx --test src/lib/learning/learningEngine.test.ts",
    "test:evidence": "tsx --test src/lib/evidence/evidenceEngine.test.ts",
    "test:policy": "tsx --test src/lib/policy/evaluatePolicy.test.ts src/lib/policy/getPolicyResult.test.ts",
    "test:experiments": "tsx --test src/lib/experiments/experimentEngine.test.ts src/lib/storage/experiments.test.ts",
    "test:simulation": "tsx --test src/lib/simulation/simulationEngine.test.ts",
    "test:execution": "tsx --test src/lib/execution/executionEngine.test.ts src/lib/storage/execution.test.ts",
    "test:timeline": "tsx --test src/lib/storage/timeline.test.ts src/lib/timeline/timelineSummary.test.ts",
    "test:hardening": "tsx --test src/lib/schema/storageVersion.test.ts src/lib/export/driverOpsSnapshot.test.ts",
    "test:reviews": "tsx --test src/lib/review/reviewEngine.test.ts src/lib/storage/reviews.test.ts",
    "test:knowledge": "tsx --test src/lib/storage/knowledge.test.ts src/lib/knowledge/knowledgeBase.test.ts src/lib/knowledge/knowledgeFromReviews.test.ts",
    "test:real-data": "tsx --test src/lib/import/rideshareCsv.test.ts src/lib/persistence/storageAdapter.test.ts src/lib/validation-report/productValidation.test.ts"
